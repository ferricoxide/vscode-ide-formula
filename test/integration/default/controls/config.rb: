# frozen_string_literal: true

control 'vscode-ide.config.file' do
  title 'Verify system-wide VSCode configuration files'

  describe file('/etc/vscode-ide.conf') do
    it { should exist }
    it { should be_file }
    its('mode') { should cmp '00644' }
    its('owner') { should eq 'root' }
    its('group') { should eq 'root' }
    its('content') { should match /"telemetryLevel":\s*"off"/ }
  end

  describe file('/etc/vscode/settings.json') do
    it { should exist }
    it { should be_file }
    its('mode') { should cmp '00644' }
    its('owner') { should eq 'root' }
    its('group') { should eq 'root' }
    its('content') { should match /"editor.formatOnSave":\s*true/ }
  end
end
