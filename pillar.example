# -*- coding: utf-8 -*-
# vim: ft=yaml
# ==============================================================================
# Visual Studio Code (VSCode) IDE Formula Pillar Configuration Example
# ==============================================================================

vscode-ide:
  # ============================================================================
  # SYSTEM-WIDE CONFIGURATION DIRECTIVES (config)
  # ============================================================================
  # Dictionary mapping absolute file paths to nested setting objects.
  # These dictionaries are serialized to JSON on target systems using
  # `file.serialize`.
  config:
    /etc/vscode-ide.conf:
      extensions.autoCheckUpdates: false
      extensions.autoUpdate: false
      telemetry.telemetryLevel: "off"
      update.mode: "none"
    /etc/vscode/settings.json:
      editor.formatOnSave: true
      files.trimTrailingWhitespace: true
      workbench.colorTheme: "Default Dark Modern"

  # ============================================================================
  # PACKAGING & REPOSITORY DIRECTIVES (pkg)
  # ============================================================================
  pkg:
    # Package identifier for native package manager installation
    # Linux default: 'code' | Windows default: 'vscode'
    name: 'code'

    # Package repository configuration (Linux RedHat family)
    repo:
      baseurl: 'https://packages.microsoft.com/yumrepos/vscode'
      enabled: 1
      gpgcheck: 1
      gpgkey: 'https://packages.microsoft.com/keys/microsoft.asc'
      name: 'vscode'
      summary: 'Visual Studio Code'

  # ============================================================================
  # OS & SECURITY OVERRIDES
  # ============================================================================
  # Group ownership for system-wide configuration files
  # Linux default: 'root' | BSD: 'wheel' | Windows: 'Administrators'
  rootgroup: 'root'
